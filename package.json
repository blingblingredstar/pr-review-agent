{
  "name": "pr-review-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "review:local": "node --env-file=.env --import tsx scripts/local.ts",
    "review:pr": "node --env-file=.env --import tsx scripts/review-pr.ts",
    "setup:webhook": "node --env-file=.env --import tsx scripts/setup-webhook.ts"
  },
  "dependencies": {
    "@ai-sdk/openai": "^4.0.104",
    "@vercel/functions": "^3.10.4",
    "ai": "^7.0.156",
    "octokit": "^5.0.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
