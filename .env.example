# 复制为 .env 并填入真实值。.env 不入库。
# 当前实例是 GLM 的 OpenAI 兼容端点（见 docs/decisions.md D002）；换厂商只改这三个值。
LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
LLM_API_KEY=
LLM_MODEL=glm-4.6

# GitHub PAT（docs/decisions.md D008）：拉 PR diff、发 review 评论；私有仓库需 repo scope
GITHUB_TOKEN=

# webhook 签名密钥（HMAC-SHA256）；scripts/setup-webhook.ts 首跑自动生成写入 .env，也可自填
WEBHOOK_SECRET=

# LLM 审查超时（毫秒），默认 270000：Vercel Hobby 函数上限 300s，留出拉 diff + 回帖余量（docs/decisions.md D011）
LLM_TIMEOUT_MS=

# 单次模型调用输出 token 上限（正整数，透传 maxOutputTokens）；未设置 = 不传。
# thinking 模型开档位时防单例烧穿（D033 实测单例 output 可至 2 万+）
LLM_MAX_OUTPUT_TOKENS=

# 端点扩展参数（JSON 对象，合并进请求体，厂商中立，docs/decisions.md D012/D033）：
# 生产现值（GLM coding 端点）：{"thinking":{"type":"enabled"},"reasoning_effort":"low"}
# 全关 thinking：{"thinking":{"type":"disabled"}}（GLM-5.3 标准 API 禁 disabled，coding 端点可用）
LLM_EXTRA_BODY=

# 端点不支持 json_schema 结构化输出时设 1：SDK 的 json_schema 自动降级 json_object + system 追加
# JSON 输出格式说明（DeepSeek 实测不支持 json_schema；GLM 生产不需要，未设置时请求字节级不变）
LLM_JSON_MODE=

# 决策模型（DECISION_MODEL，D028）独立端点：未设置逐项回退 LLM_*（与主评审共用端点，现状语义）。
# 设置后 router 走独立端点（跨厂商便宜档路由，如 DECISION_MODEL=deepseek-flash + 本组四项）。
# DECISION_JSON_MODE 独立于 LLM_JSON_MODE（全局 json 模式会波及主评审的 json_schema 路径）；
# 空白 = 未设置（回退），显式 0 = 覆盖为关
DECISION_BASE_URL=
DECISION_API_KEY=
DECISION_EXTRA_BODY=
DECISION_JSON_MODE=

# 触发白名单（docs/decisions.md D021）：逗号分隔 GitHub 用户名（大小写不敏感），仅这些用户的 PR 触发审查；
# 未设置 = 所有人（向后兼容）；填 * = 显式全放行。单人自用建议填自己的用户名
REVIEW_TRIGGER_USERS=

# 仓库上下文预算（docs/decisions.md D023，默认 100000）：审查时注入触及文件全文 + 文件树；
# 填 0 = 显式关闭上下文注入（下载失败不影响审查，best-effort）
CONTEXT_MAX_CHARS=

# 工具循环步预算（docs/decisions.md D027/D031，默认 2）：模型审查时可按需检查 head 快照——
# search_file 内容搜索（搜残留引用/既有词法相似）与 read_file 按路径读全文，两类请求共享计步
#（D031 起「步」= 工具步，不再只是读取次数）；填 0 = 显式关闭工具循环（生产 kill switch）
FILE_TOOL_MAX_STEPS=2

# 决策模型路由（docs/decisions.md D028）：可选，未设 = 关闭（零额外调用、零行为差异）。
# 设置后 review 阶段先跑便宜档 router 产出评审计划，主评审带计划评审；与 LLM_BASE_URL 同端点，
# 模型名可与 LLM_MODEL 相同，也可配便宜档
DECISION_MODEL=

# 任务上下文预算（docs/decisions.md D029，默认 4000 字符）：PR body 按 closing keywords（Closes/Fixes/Resolves…）
# 解析关联 issue 后拉正文，与 PR 标题一起拼成任务块置顶进审查 prompt；填 0 = 显式关闭（零 API 调用、prompt 与旧版一致）
TASK_CONTEXT_MAX_CHARS=

# 上一轮意见预算（docs/decisions.md D035，默认 6000 字符）：全量重审（block 继承路径）时把上一轮
# blocker/major 意见注入 prompt 要求逐字重报（根治复审措辞漂移）；填 0 = 显式关闭（零 API 调用）
PREV_FINDINGS_MAX_CHARS=

# worker 续链公开入口（生产必配，漏配时 chainBase 会打显式 warn）：VERCEL_URL 是部署专属 URL，
# 被 Vercel Standard Protection 挡（403），续链目标必须是公开可达域名（webhook 同款 URL 即可）
# 观测面板 Details 深链（#148，可选）：pr-review 状态带 target_url 指向 dashboard 面板 #pr<N>；未设置 = 不带
# DASHBOARD_PANEL_URL=https://<dashboard-项目固定域名>

WORKER_BASE_URL=

# 生产台账 outcome 的 GitHub 侧派生（#89，npm run prodlogs 用）：派生目标仓库 owner/repo 形态；
# 未设置 = 默认 blingblingredstar/pr-review-agent（本仓库）。凭证沿用 GITHUB_TOKEN；
# --skip-derive 跳过派生走纯日志口径（outcome 脏值不入账时勿用）
LEDGER_GITHUB_REPO=

# Run 写时持久化（#122 / D041）：publish 阶段把 RunRecord（repo/tokens/findings 快照）落私有 Vercel Blob。
# 凭证走 OIDC（平台注入 VERCEL_OIDC_TOKEN + BLOB_STORE_ID，两项目均可用）或静态 BLOB_READ_WRITE_TOKEN；
# 都缺席 = 写入面未开通，静默跳过（本地默认即跳过）。dashboard 读取面另见 RUNS_API_ENABLED
BLOB_STORE_ID=
BLOB_READ_WRITE_TOKEN=

# /api/runs 读取面 fail-closed 门（P0-1）：只配在 dashboard 项目（=1）；主项目不配——同仓双项目部署下
# 主项目域名打本 route 必须 404（验收闸门 6）
RUNS_API_ENABLED=

# RunRecord 保留期天数（SDK 原生 ttlDays，平台每日自动过期，1-730；默认 730，填 0 = 不过期）。
# 私有仓接入后 findings 是代码片段级敏感数据，自动过期是隐私兜底
RUNS_TTL_DAYS=
