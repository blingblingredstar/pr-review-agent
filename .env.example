# 复制为 .env 并填入真实值。.env 不入库。
# 当前实例是 GLM 的 OpenAI 兼容端点（见 docs/decisions.md D002）；换厂商只改这三个值。
LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
LLM_API_KEY=
LLM_MODEL=glm-4.6

# GitHub PAT（docs/decisions.md D008）：拉 PR diff、发 review 评论；私有仓库需 repo scope
GITHUB_TOKEN=

# webhook 签名密钥（HMAC-SHA256）；scripts/setup-webhook.ts 首跑自动生成写入 .env，也可自填
WEBHOOK_SECRET=

# LLM 审查超时（毫秒），默认 270000：Vercel Hobby 函数上限 300s，留出拉 diff + 回帖余量（docs/decisions.md D011）
LLM_TIMEOUT_MS=

# 端点扩展参数（JSON 对象，合并进请求体，厂商中立，docs/decisions.md D012）：
# GLM 等 thinking 模型关 thinking 控延迟：{"thinking":{"type":"disabled"}}
LLM_EXTRA_BODY=

# 触发白名单（docs/decisions.md D021）：逗号分隔 GitHub 用户名（大小写不敏感），仅这些用户的 PR 触发审查；
# 未设置 = 所有人（向后兼容）；填 * = 显式全放行。单人自用建议填自己的用户名
REVIEW_TRIGGER_USERS=

# 仓库上下文预算（docs/decisions.md D023，默认 100000）：审查时注入触及文件全文 + 文件树；
# 填 0 = 显式关闭上下文注入（下载失败不影响审查，best-effort）
CONTEXT_MAX_CHARS=

# read_file 工具循环步预算（docs/decisions.md D027，默认 2）：模型审查时可按需读取 head 快照里的
# 任意文件（调用方/配置/被引用模块），最多读这么多个；填 0 = 显式关闭工具循环（生产 kill switch）
FILE_TOOL_MAX_STEPS=2

# 决策模型路由（docs/decisions.md D028）：可选，未设 = 关闭（零额外调用、零行为差异）。
# 设置后 review 阶段先跑便宜档 router 产出评审计划，主评审带计划评审；与 LLM_BASE_URL 同端点，
# 模型名可与 LLM_MODEL 相同，也可配便宜档
DECISION_MODEL=

# worker 续链公开入口（生产必配，漏配时 chainBase 会打显式 warn）：VERCEL_URL 是部署专属 URL，
# 被 Vercel Standard Protection 挡（403），续链目标必须是公开可达域名（webhook 同款 URL 即可）
WORKER_BASE_URL=
